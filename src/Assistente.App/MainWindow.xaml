<Window x:Class="Assistente.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistente"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Grid>
        <!-- Estado recolhido: uma "alça" fina na borda da tela -->
        <Border x:Name="CollapsedHandle"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="8,0,0,8"
                Cursor="Hand"
                >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="HandleAvatar" Visibility="Collapsed" Width="34" Height="34"
                       RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="AvatarRotate" />
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="HandleIcon" Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="10"
                           Foreground="White" VerticalAlignment="Center" />
                <!-- (o avatar some quando a alça mostra só a setinha) -->
                <!-- Tempo do timer/cronômetro, quando algum estiver rodando -->
                <TextBlock x:Name="HandleText" Visibility="Collapsed" Margin="6,0,0,0"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Estado expandido: painel com as ferramentas -->
        <Border x:Name="ExpandedPanel"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,1,0,1"
                CornerRadius="12,0,0,12">
            <Grid>
            <Border Background="{DynamicResource PanelGlowBrush}" CornerRadius="{Binding CornerRadius, ElementName=ExpandedPanel}" IsHitTestVisible="False" />
            <DockPanel>
                <!-- Barra lateral: ferramentas + ações no rodapé (sem cabeçalho) -->
                <Border DockPanel.Dock="Left" Width="180" Background="{StaticResource SidebarBrush}"
                        CornerRadius="0,0,0,12" x:Name="Sidebar">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                                Padding="6,4">
                            <UniformGrid Columns="3">
                                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                        ToolTip="Fixar aberto" Click="PinButton_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                        ToolTip="Configurações" Click="SettingsButton_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                                        ToolTip="Recolher" Click="CollapseButton_Click" />
                            </UniformGrid>
                        </Border>
                        <ListBox x:Name="ToolList" SelectionChanged="ToolList_SelectionChanged" Padding="0,8,0,4"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False" />
                    </DockPanel>
                </Border>

                <ContentControl x:Name="ToolHost" Margin="18,14,14,12" Focusable="False" ClipToBounds="True" />
            </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
