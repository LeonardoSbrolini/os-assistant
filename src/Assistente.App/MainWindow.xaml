<Window x:Class="Assistente.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistente"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Grid>
        <!-- Estado recolhido: uma "alça" fina na borda da tela -->
        <Border x:Name="CollapsedHandle"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="8,0,0,8"
                Cursor="Hand"
                >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="HandleAvatar" Visibility="Collapsed" Width="34" Height="34"
                       RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="AvatarRotate" />
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="HandleIcon" Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="10"
                           Foreground="White" VerticalAlignment="Center" />
                <!-- (o avatar some quando a alça mostra só a setinha) -->
                <!-- Tempo do timer/cronômetro, quando algum estiver rodando -->
                <TextBlock x:Name="HandleText" Visibility="Collapsed" Margin="6,0,0,0"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Sombra do painel (separada e em cache para não pesar) -->
        <Border x:Name="PanelShadow" Visibility="{Binding Visibility, ElementName=ExpandedPanel}"
                Margin="{Binding Margin, ElementName=ExpandedPanel}" CornerRadius="16" Background="{DynamicResource PanelBrush}"
                RenderTransformOrigin="{Binding RenderTransformOrigin, ElementName=ExpandedPanel}"
                RenderTransform="{Binding RenderTransform, ElementName=ExpandedPanel}"
                Opacity="{Binding Opacity, ElementName=ExpandedPanel}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.55" />
            </Border.Effect>
            <Border.CacheMode>
                <BitmapCache />
            </Border.CacheMode>
        </Border>

        <!-- Estado expandido: painel com as ferramentas -->
        <Border x:Name="ExpandedPanel"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0"
                Background="{DynamicResource PanelBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0" />
                    <GradientStop Color="#14FFFFFF" Offset="0.4" />
                    <GradientStop Color="#0AFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
            <Border Background="{DynamicResource PanelGlowBrush}" CornerRadius="{Binding CornerRadius, ElementName=ExpandedPanel}" IsHitTestVisible="False" />
            <DockPanel>
                <!-- Barra lateral: ferramentas + ações no rodapé (sem cabeçalho) -->
                <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource SidebarBrush}"
                        CornerRadius="15,0,0,15" x:Name="Sidebar">
                    <DockPanel>
                        <!-- Botões de janela estilo Mac: vermelho recolhe, verde fixa aberto -->
                        <StackPanel x:Name="WindowDots" DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,0,8" Background="Transparent">
                            <Border x:Name="CloseDot" Width="13" Height="13" CornerRadius="6.5" Background="#FF5F57"
                                    BorderBrush="#33000000" BorderThickness="0.5" Cursor="Hand" ToolTip="Recolher"
                                    MouseLeftButtonUp="CollapseButton_Click">
                                <TextBlock x:Name="CloseGlyph" Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="7"
                                           Foreground="#B0400000" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                            </Border>
                            <Border x:Name="PinDot" Width="13" Height="13" CornerRadius="6.5" Margin="8,0,0,0" Background="#4A4D57"
                                    BorderBrush="#33000000" BorderThickness="0.5" Cursor="Hand" ToolTip="Fixar aberto"
                                    MouseLeftButtonUp="PinButton_Click">
                                <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="7"
                                           Foreground="#B0003000" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                            </Border>
                        </StackPanel>
                        <!-- Configurações no rodapé, como um item do menu -->
                        <Border x:Name="SettingsRow" DockPanel.Dock="Bottom" Margin="8,4,8,10" Padding="10,6"
                                CornerRadius="10" Background="Transparent" Cursor="Hand" ToolTip="Configurações"
                                MouseLeftButtonUp="SettingsButton_Click" />
                        <Border DockPanel.Dock="Bottom" Height="1" Margin="14,0" Background="{StaticResource CardBorderBrush}" />
                        <ListBox x:Name="ToolList" SelectionChanged="ToolList_SelectionChanged" Padding="0,0,0,4"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False" />
                    </DockPanel>
                </Border>

                <ContentControl x:Name="ToolHost" Margin="20,16,16,14" Focusable="False" ClipToBounds="True" />
            </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
