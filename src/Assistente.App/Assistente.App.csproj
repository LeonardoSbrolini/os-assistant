<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 libera as APIs do Windows de controle de mídia (aba Música). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Usado apenas para o ícone na bandeja do sistema (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Assistente.App</RootNamespace>
    <AssemblyName>Assistente</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.9.2</Version>
    <Product>Assistente</Product>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Informa ao atualizador qual arquivo baixar (completo ou leve). -->
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
    <!-- Repositório do GitHub de onde vêm as atualizações (dono/nome). -->
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <PropertyGroup>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">LeonardoSbrolini/os-assistant</UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Informações de hardware (WMI) e contadores de disco -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <!-- Guarda a chave da IA criptografada com a conta do Windows -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistente.Core\Assistente.Core.csproj" />
  </ItemGroup>

</Project>
